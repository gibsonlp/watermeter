# should go under /etc/water_analyzer/
[Database]
username = username     // EDIT ME
password = p@ssw0rd     // EDIT ME
host = localhost        // EDIT ME
db = database           // EDIT ME

# Used by monitoring script
[Email]
enabled = true
smtp_host = smtp.myisp.con                      // EDIT ME
smtp_port = 25                                  // EDIT ME
smtp_ssl = true
smtp_user = username                            // EDIT ME
smtp_pass = password                            // EDIT ME
from_addr = WaterMeter <example@example.com>    // EDIT ME
to_addr = example@example.com                   // EDIT ME

# This is specific for my own irrigation, feel free to adjust to your needs
[Analysis]
# Set to false if you only want global leak/error checks (no irrigation analysis)
enable_line_monitoring = false
daily_leak_limit_liters = 1500
# Optional: Separate household consumption limit (deducts active irrigation from daily checks)
daily_household_limit_liters = 1000

[Line_0]
name = Front Garden
limit_dal = 70
limit_flow = 3500
isolation_check = false

[Line_1]
name = Rear Garden
limit_dal = 55
limit_flow = 3500
isolation_check = false

[Line_2]
name = Trees Pots
# 2 DAL = 20 Liters
limit_dal = 2
# 20 clpm = 0.2 Liters/min (Very low threshold)
limit_flow = 20
isolation_check = true

[Ulanzi]
enabled = true
ip = 1.2.3.4                                    // EDIT ME
update_interval = 4
# Blue color for water
color = 0,150,255
# Icons from Awtrix/Ulanzi library
icon_static = 8990
icon_anim = 55027
api_url = http://127.0.0.1:8081/api/bath_data   // EDIT ME
